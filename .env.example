# Connection string de Postgres (Neon), usada SOLO por el proxy
# serverless en api/org-mapping.ts (server-side) para guardar el mapeo de
# Settings (Organizacion de Jira <-> Cliente de Janis Data).
#
# Cargar este valor en Vercel -> Project Settings -> Environment Variables
# (ambiente Production). Formato tipico de Neon:
#   postgresql://usuario:password@host/basededatos?sslmode=require
DATABASE_URL=

# Credenciales de Atlassian (Jira), usadas SOLO por el proxy serverless en
# api/jira-agent-activity.ts (server-side) para la tab "Team Data" —
# actividad de agentes (comentarios y cambios de estado) en el proyecto
# JCS. El token nunca debe hardcodearse en el repo ni llegar al browser.
#
# Cargar estos valores en Vercel -> Project Settings -> Environment
# Variables (Production, y Preview/Development si se prueba con
# `vercel dev`).
#   JIRA_EMAIL      - cuenta de Atlassian con acceso al proyecto JCS
#   JIRA_API_TOKEN  - generado en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Opcionales (tienen default en el código si se dejan vacios):
#   JIRA_SITE=janiscommerce.atlassian.net
#   JIRA_PROJECT=JCS
JIRA_SITE=
JIRA_PROJECT=
