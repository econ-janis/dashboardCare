# Credenciales de la API de Janis (order-report), usadas SOLO por el
# proxy serverless en api/janis-order-report.ts (server-side).
#
# IMPORTANTE: no usar el prefijo VITE_ en estas variables — eso haría que
# Vite las incluya en el bundle público del frontend. Cargar estos 3
# valores en Vercel → Project Settings → Environment Variables
# (ambiente Production).
JANIS_CLIENT=
JANIS_API_KEY=
JANIS_API_SECRET=
